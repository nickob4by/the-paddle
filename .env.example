# Turso Database Credentials (Set these in Vercel Project Settings -> Environment Variables)
TURSO_DATABASE_URL="libsql://the-paddle-nickob4by.aws-ap-southeast-2.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# Vercel Blob Storage Token (Automatically added if deploying on Vercel)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Cloudinary Storage Credentials (If deploying on Cloudflare Pages, Netlify, or Render)
# Free 25GB account at https://cloudinary.com
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

